# Copy to .env and fill in. NEVER commit .env.

NODE_ENV=development
APP_URL=http://localhost:3000

# Logging (debug | info | warn | error). Use debug only in local development.
LOG_LEVEL=info

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/omniconnect?schema=public

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379

# Auth (NextAuth / Auth.js v5)
NEXTAUTH_SECRET=
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
# Auth.js v5 needs this off Vercel so /api/auth/* does not 500 UntrustedHost.
AUTH_TRUST_HOST=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# OpenRouter unified AI gateway
OPENROUTER_API_KEY=
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_SITE_NAME=OmniConnect AI
AI_DEFAULT_MODEL=openai/gpt-4o-mini
AI_REPLY_MODEL=
AI_DASHBOARD_MODEL=
AI_CONTENT_MODEL=
AI_ANALYSIS_MODEL=

# Shopify
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# Meta
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

# Storage (S3-compatible)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Security
# Generate with: openssl rand -base64 48
ENCRYPTION_KEY=
# Optional: previous key used for rotation. Set when rotating ENCRYPTION_KEY, run re-encryption, then remove.
ENCRYPTION_KEY_PREVIOUS=
# Trusted client-IP header for rate limiting. Fly.io: Fly-Client-IP. Cloudflare: CF-Connecting-IP.
RATE_LIMIT_IP_HEADER=

# Observability
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# Payments (Stripe)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=

# Super admin (env-driven, seed-only)
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PHONE=
SUPER_ADMIN_PASSWORD=
# Set to true to allow the seed script to reconcile an existing super-admin's password/flag.
SUPER_ADMIN_RECONCILE=false

# Identity self-service
# Require email verification before AI/store/checkout. Set false to disable for local dev/tests.
REQUIRE_EMAIL_VERIFICATION=true

# Cloudflare Turnstile (bot protection). Leave unset to disable.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# SMS provider for phone verification (console | twilio | disabled)
SMS_PROVIDER=disabled
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Email (console | smtp)
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
