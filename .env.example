# Copy to .env and fill in. NEVER commit .env.

NODE_ENV=development
APP_URL=http://localhost:3000

# Logging (debug | info | warn | error). Use debug only in local development.
LOG_LEVEL=info

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/omniconnect?schema=public

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379

# Auth (NextAuth / Auth.js v5)
NEXTAUTH_SECRET=
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
# Auth.js v5 needs this off Vercel so /api/auth/* does not 500 UntrustedHost.
AUTH_TRUST_HOST=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# AI
OPENAI_API_KEY=

# Shopify
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# Meta
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

# Storage (S3-compatible)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Security
# Generate with: openssl rand -base64 48
ENCRYPTION_KEY=
# Optional: previous key used for rotation. Set when rotating ENCRYPTION_KEY, run re-encryption, then remove.
ENCRYPTION_KEY_PREVIOUS=

# Observability
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# Payments (Stripe)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=

# Super admin (env-driven, seed-only)
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PHONE=
SUPER_ADMIN_PASSWORD=

# Email (console | smtp)
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
