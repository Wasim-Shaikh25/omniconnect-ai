{
  "name": "omniconnect-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build && npm run build:worker",
    "build:worker": "esbuild src/jobs/worker.ts --bundle --platform=node --target=node20 --outfile=.next/standalone/worker.cjs --format=cjs --packages=external",
    "start": "next start",
    "worker": "tsx src/jobs/worker.ts",
    "worker:prod": "node .next/standalone/worker.cjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev"
  },
  "overrides": {
    "sharp": "^0.35.3",
    "postcss": "^8.5.22",
    "@auth/core": "0.41.3",
    "nodemailer": "9.0.1",
    "vite": "^6.2.0",
    "protobufjs": "7.6.5"
  },
  "dependencies": {
    "@auth/core": "0.41.3",
    "@auth/prisma-adapter": "^2.7.4",
    "@marsidev/react-turnstile": "1.5.3",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.221.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@prisma/client": "^6.2.1",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-slot": "^1.1.1",
    "@sentry/nextjs": "^10.68.0",
    "@types/jspdf": "^1.3.3",
    "@types/nodemailer": "8.0.1",
    "@xenova/transformers": "^2.17.2",
    "bcryptjs": "^2.4.3",
    "bullmq": "5.80.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "html-to-image": "^1.11.13",
    "ioredis": "5.11.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.469.0",
    "next": "^15.5.21",
    "next-auth": "^5.0.0-beta.32",
    "next-themes": "^0.4.4",
    "nodemailer": "9.0.1",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "stripe": "^17.1.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^15.5.21",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^3.2.7",
    "esbuild": "^0.25.12",
    "eslint": "^10.0.0",
    "postcss": "^8.5.22",
    "prettier": "^3.4.2",
    "prisma": "^6.2.1",
    "tailwindcss": "^3.4.1",
    "tsx": "4.23.1",
    "typescript": "^5",
    "typescript-eslint": "^8.65.0",
    "vitest": "^3.2.6"
  }
}
