  DRAFT
  APPROVED
  EXECUTED
  FAILED
  STOPPED
}

enum DecisionType {
  APPROVED
  EDITED
  ASSIGNED
  SNOOZED
  REJECTED
  EXPIRED
}

enum OutcomeStatus {
  PENDING
  SUCCESS
  PARTIAL
  FAILURE
  ABORTED
}

enum GoalStatus {
  ACTIVE
  PAUSED
  ACHIEVED
  MISSED
  ABANDONED
}

model Recommendation {
  id                 String               @id @default(cuid())
  organizationId     String
  storeId            String?
  insightId          String?
  producedByModule   String
  producedByService  String?
  title              String
  description        String
  objective          String?
  businessObjective  BusinessObjective?
  reasoning          String?
  marketContext      String?
  competitorContext  String?
  selfContext        String?
  reasonCodes        String[]
  impactRange        Json?
  confidence         Float?
  confidenceSignals  Int                  @default(0)
  effort             String?
  urgency            String?
  riskTier           RiskTier
  eligibility        Json?
  status             RecommendationStatus @default(PROPOSED)
  actionType         String
  actionParams       Json?
  deepLink           String?
  validFrom          DateTime             @default(now())
  validUntil         DateTime?
  invalidatedAt      DateTime?
  invalidatedByEvent String?
  generatedAt        DateTime             @default(now())
  dismissedAt        DateTime?
  snoozedUntil       DateTime?
