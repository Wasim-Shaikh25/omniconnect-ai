// OmniConnect AI — Prisma schema (core tables).
// Each model is owned by a module (see docs/architecture/module-boundaries.md).
// Schema changes go through `prisma migrate` — never hand-edit generated artifacts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── auth / users ────────────────────────────────────────────────────────────
enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum Role {
  USER
  SUPER_ADMIN
}

enum Plan {
  FREE
  PRO
  BUSINESS
}

model User {
  id                      String     @id @default(cuid())
  email                   String     @unique
  emailVerified           DateTime?
  name                    String?
  passwordHash            String?
  phone                   String?    // E.164
  phoneVerified           DateTime?
  mobile                  String?    // E.164 (legacy alias, will be migrated to phone)
  mobileVerified          DateTime?
  age                     Int?
  gender                  Gender?
  companyName             String?
  image                   String?
  userId                  String?    // tenant / owning-user id (self for owners, owner id for invited staff)
  projectId               String?    // selected active project (session state persisted on user)
  role                    Role       @default(USER)
  isSuperAdmin            Boolean    @default(false)
  plan                    Plan       @default(FREE)
  subscriptionId          String?
  subscriptionStatus      String?
  stripeCustomerId        String?
  aiRepliesThisMonth      Int        @default(0)
  aiRepliesResetAt        DateTime?
  maxWorkspaces           Int        @default(1)  // cached plan limit
  maxProjects             Int        @default(1)  // cached plan limit
  maxAiCallsPerDay        Int        @default(20) // cached plan limit
  profileInspectionsToday   Int        @default(0)
  profileInspectionsResetAt DateTime?
  tokenVersion            Int        @default(0)
  deletedAt               DateTime?
  deletedReason           String?
  dataExportRequestedAt   DateTime?
  dataExportExpiresAt     DateTime?
  suspendedAt             DateTime?
  banned                  Boolean    @default(false)
  createdAt               DateTime   @default(now())
  updatedAt               DateTime   @updatedAt

  workspaces                    Workspace[]
  accounts                      Account[]
  sessions                      Session[]
  verificationRequests          VerificationRequest[]
  notifications                 Notification[]
  auditLogsTarget               AuditLog[] @relation("AuditLogTargetUser")
  auditLogsActor                AuditLog[] @relation("AuditLogActorUser")
  tickets                       SupportTicket[]
  ticketComments                TicketComment[]
  exportRequests                ExportRequest[]
  notificationPreferences       Json?
  notificationPreferencesDetail NotificationPreference[]
  tokenUsage                    TokenUsage[]

  @@index([deletedAt])
  @@index([dataExportExpiresAt])
}

// NextAuth (Auth.js) adapter models.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@index([identifier])
  @@index([expires])
}

// One-time codes used for super-admin MFA. Kept separate from password-reset tokens.
model MfaCode {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@unique([email, code])
  @@index([email])
  @@index([expiresAt])
}

// One-time codes used for password reset. Kept separate from MFA codes.
model PasswordResetCode {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@unique([email, code])
  @@index([email])
  @@index([expiresAt])
}

// Hashed, time-bounded verification tokens for email signup, email change, and phone
// verification. The plaintext token is never stored.
model VerificationRequest {
  id         String    @id @default(cuid())
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel    String    // "email" | "phone"
  purpose    String    // "signup" | "email_change" | "phone_verify" | "mfa"
  target     String    // the address or E.164 number being proven
  tokenHash  String    @unique
  salt       String?   // per-request random salt for short code verification
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, purpose])
  @@index([target, purpose])
  @@index([expiresAt])
}


// ── workspaces / projects ───────────────────────────────────────────────────
model Workspace {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  projects Project[]

  @@index([userId])

}

model Project {
  id                String   @id @default(cuid())
  workspaceId       String
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId            String    // denormalized tenant for store-style queries
  name              String
  provider          String?   // e.g. SHOPIFY, MOCK
  domain            String?
  metaAccountId     String?
  metaAccessToken   String?   // encrypted at application layer
  metaTokenExpiresAt DateTime?
  metaPixelId       String?
  archivedAt        DateTime?
  deletedAt         DateTime?
  lastProductSyncAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([userId])

  ecommerceConnections EcommerceConnection[]
  aiConfigurations     AIConfiguration[]
  tokenUsage           TokenUsage[]

  @@index([workspaceId])

  products Product[]
  coupons Coupon[]
  orders Order[]
  customers Customer[]
  conversations Conversation[]
  carts Cart[]
  followers Follower[]
  campaigns Campaign[]
  mediaPosts MediaPost[]
  accountInsights AccountInsight[]
  trendSnapshots TrendSnapshot[]
  contentRecommendations ContentRecommendation[]
  metaCatalogSyncs MetaCatalogSync[]
  metaProductMappings MetaProductMapping[]
  shoppableMedias ShoppableMedia[]
  socialComments SocialComment[]
  socialMentions SocialMention[]
  socialLeads SocialLead[]
  ugcAssets UgcAsset[]
  ambassadors Ambassador[]
  referralOrders ReferralOrder[]
  dmCampaigns DmCampaign[]
  backInStockSubscriptions BackInStockSubscription[]
  commentUnlockCampaigns CommentUnlockCampaign[]
  brandDeals BrandDeal[]
  dashboardShares DashboardShare[]
  attributionLinks AttributionLink[]
}

model OrganizationInvite {
  id              String   @id @default(cuid())
  email           String
  userId          String   // owning user / organization
  projectId       String?
  role            Role     @default(USER)
  status          String   @default("PENDING")
  token           String   @unique
  createdByUserId String
  createdAt       DateTime @default(now())
  expiresAt       DateTime

  @@unique([userId, email], name: "organizationId_email")
  @@index([token])
  @@index([userId, status])
}

model PlanConfig {
  id                        String   @id @default(cuid())
  plan                      String   @unique // FREE, PRO, BUSINESS
  maxWorkspaces             Int?
  maxProjects               Int?
  monthlyAiReplies          Int?
  maxProfileInspectionsPerDay Int?
  teamSeats                 Int?
  maxStores                 Int?
  maxCompetitors            Int?
  maxAttributionLinksPerMonth Int?
  maxContentSchedulesPerMonth Int?
  allowedModels             String[] @default([])
  priceMonthlyCents         Int      @default(0)
  isDefault                 Boolean  @default(false)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
}

model EcommerceConnection {
  id           String   @id @default(cuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  provider     String   // platform name or "CUSTOM"
  baseUrl      String?
  accessToken  String?  // encrypted at application layer
  refreshToken String?  // encrypted at application layer
  config       Json?    // AdapterConfigMapping or provider config
  isActive     Boolean  @default(true)
  lastSyncAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([projectId])
  @@index([provider])
}

model AttributionLink {
  id            String   @id @default(cuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  couponId      String?
  coupon        Coupon?  @relation(fields: [couponId], references: [id], onDelete: SetNull)
  fullUrl       String
  shortCode     String   @unique
  utmSource     String
  utmMedium     String?
  utmCampaign   String?
  clicks        Int      @default(0)
  conversions   Int      @default(0)
  revenue       Decimal  @default(0) @db.Decimal(12, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([projectId, createdAt])
  @@index([shortCode])
  @@index([couponId])
}

// ── ai configuration ─────────────────────────────────────────────────────────
model AIConfiguration {
  id                String   @id @default(cuid())
  projectId         String   @unique
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  aiName            String?
  brandVoice        String?
  language          String   @default("en")
  systemPrompt      String   @default("You are a helpful AI assistant for this brand.")
  tone              String?
  welcomeStrategy   String?
  couponStrategy    String?
  salesStrategy     String?
  enabledSkills     Json     @default("{}")
  salesRules        Json     @default("{}")
  channelSettings   Json     @default("{}")
  escalationRules   Json     @default("{}")
  modelOverrides    Json     @default("{}")
  knowledgeBase     String?
  productKnowledge  String?
  model             String   @default("gpt-4o-mini")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([projectId])
}

model TokenUsage {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId       String?
  project         Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  feature         String   // e.g. "reply", "content", "dashboard"
  model           String
  promptTokens    Int
  completionTokens Int
  totalTokens     Int
  cost            Decimal? @db.Decimal(12, 6)
  createdAt       DateTime @default(now())

  @@index([userId, createdAt])
  @@index([projectId, createdAt])
  @@index([feature, createdAt])
}

// ── ecommerce ───────────────────────────────────────────────────────────────
enum EcommerceProvider {
  SHOPIFY
  WOOCOMMERCE
  BIGCOMMERCE
  MAGENTO
  WIX
  CUSTOM
}




model Product {
  id          String    @id @default(cuid())
  externalId  String
  title       String
  description String?
  price       Decimal?  @db.Decimal(12, 2)
  currency    String?
  inventory   Int?
  imageUrl    String?
  deletedAt   DateTime?
  projectId     String
  project       Project     @relation(fields: [projectId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  metaProductMappings      MetaProductMapping[]
  backInStockSubscriptions BackInStockSubscription[]

  @@unique([projectId, externalId])
  @@index([deletedAt])

}

// ── coupons ─────────────────────────────────────────────────────────────────
enum CouponStatus {
  ACTIVE
  DISABLED
  EXPIRED
}

model Coupon {
  id                String       @id @default(cuid())
  code              String
  discountPct       Int
  status            CouponStatus @default(ACTIVE)
  expiresAt         DateTime?
  deletedAt         DateTime?
  usageCount        Int          @default(0)
  revenueAttributed Decimal?     @db.Decimal(12, 2)
  lastUsedAt        DateTime?
  projectId           String
  project             Project        @relation(fields: [projectId], references: [id])
  customerId        String?
  customer          Customer?    @relation(fields: [customerId], references: [id])
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  usages CouponUsage[]
  attributionLinks AttributionLink[]

  @@unique([projectId, code])
  @@index([deletedAt])

}

model CouponUsage {
  id         String    @id @default(cuid())
  couponId   String
  coupon     Coupon    @relation(fields: [couponId], references: [id])
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  usedAt     DateTime  @default(now())
  orderRef   String?

  @@index([couponId])
  @@index([customerId])
}

enum AttributionSource {
  META_POST
  META_DM
  META_STORY
  META_LIVE
  COUPON
  DIRECT
}

model Order {
  id                  String             @id @default(cuid())
  externalId          String
  projectId             String
  project               Project              @relation(fields: [projectId], references: [id])
  total               Decimal?           @db.Decimal(12, 2)
  currency            String?
  orderDate           DateTime
  couponCode          String?
  customerRef         String?
  customerEmail       String?
  attributedMediaId   String?
  attributionSource   AttributionSource?
  isFirstTimeCustomer Boolean            @default(false)
  syncedAt            DateTime           @default(now())
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@unique([projectId, externalId])
  @@index([projectId, attributedMediaId])
  @@index([projectId, couponCode])
  @@index([projectId, orderDate])
  @@index([projectId, isFirstTimeCustomer])
}

// ── crm (customers) ─────────────────────────────────────────────────────────
enum CustomerLifecycleStage {
  LEAD
  PROSPECT
  CUSTOMER
  CHURNED
}

enum CustomerConsent {
  PENDING
  GRANTED
  DECLINED
}

model Customer {
  id               String                 @id @default(cuid())
  projectId          String
  project            Project                  @relation(fields: [projectId], references: [id])
  igUserId         String?
  fbUserId         String?
  username         String?
  interests        String[]
  tags             String[]
  lifecycleStage   CustomerLifecycleStage @default(LEAD)
  consent          CustomerConsent        @default(PENDING)
  consentUpdatedAt DateTime?
  lastActivityAt   DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  conversations            Conversation[]
  coupons                  Coupon[]
  couponUsages             CouponUsage[]
  followers                Follower[]
  socialLeads              SocialLead[]
  ugcAssets                UgcAsset[]
  ambassadors              Ambassador[]
  backInStockSubscriptions BackInStockSubscription[]

  @@index([projectId])
  @@index([igUserId])
  @@index([fbUserId])
}

// ── meta / conversations ────────────────────────────────────────────────────
enum ConversationChannel {
  INSTAGRAM
  FACEBOOK
}

enum ConversationStatus {
  AI_ACTIVE
  HUMAN_ACTIVE
}

model Conversation {
  id              String              @id @default(cuid())
  channel         ConversationChannel
  status          ConversationStatus  @default(AI_ACTIVE)
  externalId      String?
  projectId         String
  project           Project               @relation(fields: [projectId], references: [id])
  customerId      String?
  customer        Customer?           @relation(fields: [customerId], references: [id])
  assignedHumanId String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  messages Message[]

  @@index([projectId])
  @@index([projectId, customerId])
  @@index([customerId])
  @@index([assignedHumanId])

}

enum MessageSender {
  CUSTOMER
  AI
  HUMAN
}

model Message {
  id                 String        @id @default(cuid())
  conversationId     String
  conversation       Conversation  @relation(fields: [conversationId], references: [id])
  inReplyToMessageId String?
  sender             MessageSender
  content            String
  createdAt          DateTime      @default(now())

  @@unique([conversationId, inReplyToMessageId])
  @@index([conversationId])
  @@index([createdAt])
  @@index([conversationId, createdAt(sort: Desc)])
}

model Cart {
  id             String    @id @default(cuid())
  projectId        String
  project          Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  cartToken      String
  email          String?
  lineItemTitles String[]
  totalPrice     Decimal?  @db.Decimal(12, 2)
  currency       String?
  recoveredUrl   String?
  lastActivityAt DateTime
  notifiedAt     DateTime?
  convertedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([projectId, cartToken])
  @@index([projectId, lastActivityAt])
  @@index([notifiedAt])
}

model Follower {
  id                 String    @id @default(cuid())
  projectId            String
  project              Project     @relation(fields: [projectId], references: [id])
  customerId         String?
  customer           Customer? @relation(fields: [customerId], references: [id])
  igUserId           String?
  username           String?
  followedAt         DateTime  @default(now())
  couponId           String?
  campaignEnrolledAt DateTime?
  welcomeMessageText String?

  @@unique([projectId, igUserId])
}

model BrainConversationMemory {
  id                String   @id @default(cuid())
  userId            String
  projectId         String?
  question          String
  answer            String
  acceptedAdviceIds String[]
  rejectedAdviceIds String[]
  goals             String[]
  dailyActionId     String?
  outcomeId         String?
  expiresAt         DateTime
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId, projectId])
  @@index([userId, createdAt])
  @@index([expiresAt])
}

model RecommendationConflict {
  id             String   @id @default(cuid())
  userId String
  projectId        String?
  winnerId       String
  runnerUpId     String?
  winnerTitle    String
  runnerUpTitle  String?
  reason         String
  appliedPolicy  String
  resolvedAt     DateTime @default(now())

  @@index([userId, projectId])
  @@index([resolvedAt])
}

// ── campaigns (first-time follower) ─────────────────────────────────────────
enum CampaignType {
  FIRST_TIME_FOLLOWER
}

model Campaign {
  id              String       @id @default(cuid())
  projectId         String
  project           Project        @relation(fields: [projectId], references: [id])
  type            CampaignType @default(FIRST_TIME_FOLLOWER)
  name            String
  discountPct     Int          @default(10)
  couponTtlDays   Int          @default(30)
  messageTemplate String
  active          Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([projectId, type])
}

// ── reports ─────────────────────────────────────────────────────────────────
enum ReportPeriod {
  WEEKLY
  MONTHLY
}

model Report {
  id          String       @id @default(cuid())
  projectId     String
  period      ReportPeriod
  content     Json
  generatedAt DateTime     @default(now())

  @@index([projectId, generatedAt])
}

// ── analytics / competitor intelligence ─────────────────────────────────────
model TrackedAccount {
  id           String    @id @default(cuid())
  projectId      String
  platform     String    @default("INSTAGRAM")
  handle       String
  niche        String?
  note         String?
  lastMedia    Json?
  lastAnalysis Json?
  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([projectId, handle])
}

enum MediaType {
  POST
  REEL
  STORY
  LIVE
  CAROUSEL
}

enum TrendSnapshotType {
  HASHTAG
  AUDIO
  NICHE
}

model MediaPost {
  id              String     @id @default(cuid())
  projectId         String
  project           Project      @relation(fields: [projectId], references: [id])
  trackedAccountId String?
  externalId      String
  platform        String     @default("INSTAGRAM")
  mediaType       MediaType  @default(POST)
  permalink       String?
  caption         String?
  hashtags        String[]
  audioId         String?
  audioName       String?
  thumbnailUrl    String?
  publishedAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  insights MediaInsight[]

  @@unique([projectId, externalId])
  @@index([projectId, publishedAt])

}

model MediaInsight {
  id            String    @id @default(cuid())
  mediaPostId   String
  mediaPost     MediaPost @relation(fields: [mediaPostId], references: [id], onDelete: Cascade)
  impressions   Int?
  reach         Int?
  likes         Int?
  comments      Int?
  shares        Int?
  saves         Int?
  plays         Int?
  views         Int?
  engagementRate Decimal? @db.Decimal(5, 4)
  fetchedAt     DateTime  @default(now())

  @@index([mediaPostId, fetchedAt])
}

model AccountInsight {
  id            String   @id @default(cuid())
  projectId       String
  project         Project    @relation(fields: [projectId], references: [id])
  date          DateTime
  followers     Int?
  profileViews  Int?
  reach         Int?
  impressions   Int?
  websiteClicks Int?
  audienceJson  Json?
  fetchedAt     DateTime @default(now())

  @@index([projectId, date])
}

model TrendSnapshot {
  id        String            @id @default(cuid())
  projectId   String
  project     Project             @relation(fields: [projectId], references: [id])
  type      TrendSnapshotType
  query     String
  data      Json
  fetchedAt DateTime          @default(now())

  @@index([projectId, type, query, fetchedAt])
}

model ContentRecommendation {
  id              String   @id @default(cuid())
  projectId         String
  project           Project    @relation(fields: [projectId], references: [id])
  type            String   @default("REEL")
  title           String
  outline         String
  hashtags        String[]
  audioSuggestion String?
  generatedAt     DateTime @default(now())
  basedOnMediaIds Json

  @@index([projectId, generatedAt])
}

model DashboardShare {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  token     String   @unique
  title     String?
  schema    Json
  expiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([token])
  @@index([projectId, createdAt])
}

// ── notifications ───────────────────────────────────────────────────────────
enum NotificationType {
  NEW_MESSAGE
  NEW_FOLLOWER
  COUPON_GENERATED
  COUPON_USED
  ESCALATION
  CONVERSATION_TAKEN_OVER
  AI_RESUMED
  ABANDONED_CART
  SYSTEM_ERROR
  INTELLIGENCE
}

enum NotificationChannel {
  IN_APP
  EMAIL
}

enum NotificationDeliveryTier {
  CRITICAL_INTERRUPT
  ACTION_REQUIRED
  TODAY_FEED
  DIGEST
  ON_DEMAND
}

model Notification {
  id        String                   @id @default(cuid())
  userId    String
  user      User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId   String?
  type      NotificationType
  channel   NotificationChannel      @default(IN_APP)
  tier      NotificationDeliveryTier @default(TODAY_FEED)
  title     String
  body      String
  payload   Json?
  dedupKey  String?
  read      Boolean                  @default(false)
  createdAt DateTime                 @default(now())

  @@index([userId, read, createdAt])
  @@index([dedupKey, createdAt])
}

// ── commerce (Phase 2) ──────────────────────────────────────────────────────
enum CatalogSyncStatus {
  PENDING
  IN_PROGRESS
  SUCCESS
  FAILED
}

model MetaCatalogSync {
  id                String            @id @default(cuid())
  projectId           String
  project             Project             @relation(fields: [projectId], references: [id])
  externalCatalogId String?
  status            CatalogSyncStatus @default(PENDING)
  lastSyncedAt      DateTime?
  errorLog          String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([projectId, status])
}

model MetaProductMapping {
  id                String    @id @default(cuid())
  projectId           String
  project             Project     @relation(fields: [projectId], references: [id])
  productId         String
  product           Product   @relation(fields: [productId], references: [id])
  externalProductId String?
  externalCatalogId String?
  status            String    @default("PENDING")
  lastPushedAt      DateTime?
  errorMessage      String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([projectId, productId])
  @@index([projectId, status])
}

enum ShoppableMediaStatus {
  DRAFT
  PUBLISHED
  FAILED
}

model ShoppableMedia {
  id              String               @id @default(cuid())
  projectId         String
  project           Project                @relation(fields: [projectId], references: [id])
  externalMediaId String?
  mediaType       String
  caption         String?
  permalink       String?
  productTags     Json?
