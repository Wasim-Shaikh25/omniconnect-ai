  @@index([storeId, eventType, ingestedAt])
  @@index([organizationId, ingestedAt])
}

model EntityLink {
  id               String          @id @default(cuid())
  organizationId   String
  storeId          String?
  sourceType       String
  sourceId         String
  targetType       String
  targetId         String
  linkType         String
  confidence       ConfidenceLevel
  resolutionMethod String?
