// OmniConnect AI — Prisma schema (core tables).
// Each model is owned by a module (see docs/architecture/module-boundaries.md).
// Schema changes go through `prisma migrate` — never hand-edit generated artifacts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── auth / users ────────────────────────────────────────────────────────────
enum Role {
  ADMIN
  STORE_OWNER
  STAFF
}

model User {
  id                      String        @id @default(cuid())
  email                   String        @unique
  emailVerified           DateTime?
  name                    String?
  passwordHash            String?
  phone                   String?
  image                   String?
  role                    Role          @default(STORE_OWNER)
  isSuperAdmin            Boolean       @default(false)
  organizationId          String?
  organization            Organization? @relation(fields: [organizationId], references: [id])
  storeId                 String?
  store                   Store?        @relation(fields: [storeId], references: [id])
  notificationPreferences Json?
  tokenVersion            Int           @default(0)
  deletedAt               DateTime?
  deletedReason           String?
  dataExportRequestedAt   DateTime?
  dataExportExpiresAt     DateTime?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  notifications                 Notification[]
  accounts                      Account[]
  sessions                      Session[]
  auditLogs                     AuditLog[]
  tickets                       SupportTicket[]
  ticketComments                TicketComment[]
  projectMembers                ProjectMember[]
  exportRequests                ExportRequest[]
  notificationPreferencesDetail NotificationPreference[]

  @@index([organizationId])
  @@index([storeId])
  @@index([deletedAt])
  @@index([dataExportExpiresAt])
}

// NextAuth (Auth.js) adapter models.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@index([identifier])
  @@index([expires])
}

// One-time codes used for super-admin MFA. Kept separate from password-reset tokens.
model MfaCode {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@unique([email, code])
  @@index([email])
  @@index([expiresAt])
}

// One-time codes used for password reset. Kept separate from MFA codes.
model PasswordResetCode {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@unique([email, code])
  @@index([email])
  @@index([expiresAt])
}

// ── organizations ───────────────────────────────────────────────────────────
enum Plan {
  FREE
  STARTER
  PRO
}

model Organization {
  id                 String    @id @default(cuid())
  name               String
  plan               Plan      @default(FREE)
  subscriptionId     String?
  subscriptionStatus String?
  aiRepliesThisMonth Int       @default(0)
  aiRepliesResetAt   DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  users     User[]
  stores    Store[]
  auditLogs AuditLog[]
  projects  Project[]
  invites   OrganizationInvite[]

  @@unique([subscriptionId])
  @@index([aiRepliesResetAt])
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
}

model OrganizationInvite {
  id              String       @id @default(cuid())
  email           String
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role            Role         @default(STAFF)
  storeId         String?
  status          InviteStatus @default(PENDING)
  token           String       @unique
  createdByUserId String
  createdAt       DateTime     @default(now())
  expiresAt       DateTime

  @@unique([organizationId, email])
  @@index([token])
  @@index([organizationId, status])
}

// ── projects ────────────────────────────────────────────────────────────────
enum ProjectMemberRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

model Project {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  name            String
  description     String?
  instagramHandle String?
  integrationId   String?
  integration     Integration? @relation(fields: [integrationId], references: [id], onDelete: SetNull)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  members ProjectMember[]

  @@index([organizationId])
}

model ProjectMember {
  id        String            @id @default(cuid())
  projectId String
  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      ProjectMemberRole
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([projectId, userId])
}

// ── ecommerce ───────────────────────────────────────────────────────────────
enum EcommerceProvider {
  SHOPIFY
  WOOCOMMERCE
  BIGCOMMERCE
  MAGENTO
  WIX
  CUSTOM
}

model Store {
  id                String            @id @default(cuid())
  name              String
  provider          EcommerceProvider @default(SHOPIFY)
  domain            String?
  organizationId    String
  organization      Organization      @relation(fields: [organizationId], references: [id])
  archivedAt        DateTime?
  deletedAt         DateTime?
  lastProductSyncAt DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  integrations             Integration[]
  products                 Product[]
  orders                   Order[]
  coupons                  Coupon[]
  customers                Customer[]
  conversations            Conversation[]
  followers                Follower[]
  campaigns                Campaign[]
  aiConfig                 AIConfiguration?
  staff                    User[]
  catalogSyncs             MetaCatalogSync[]
  productMappings          MetaProductMapping[]
  shoppableMedia           ShoppableMedia[]
  socialComments           SocialComment[]
  socialMentions           SocialMention[]
  socialLeads              SocialLead[]
  ugcAssets                UgcAsset[]
  ambassadors              Ambassador[]
  referralOrders           ReferralOrder[]
  dmCampaigns              DmCampaign[]
  backInStockSubscriptions BackInStockSubscription[]
  commentUnlockCampaigns   CommentUnlockCampaign[]
  brandDeals               BrandDeal[]
  mediaPosts               MediaPost[]
  accountInsights          AccountInsight[]
  trendSnapshots           TrendSnapshot[]
  contentRecommendations   ContentRecommendation[]

  @@index([organizationId])
  @@index([deletedAt])
}

enum IntegrationType {
  ECOMMERCE
  META
}

model Integration {
  id           String          @id @default(cuid())
  type         IntegrationType
  provider     String
  externalId   String?
  accessToken  String?
  refreshToken String?
  scopes       String?
  metadata     Json?
  storeId      String
  store        Store           @relation(fields: [storeId], references: [id])
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  projects Project[]

  @@index([storeId, type])
  @@index([storeId, type, provider])
  @@index([externalId])
}

model Product {
  id          String    @id @default(cuid())
  externalId  String
  title       String
  description String?
  price       Decimal?  @db.Decimal(12, 2)
  currency    String?
  inventory   Int?
  imageUrl    String?
  deletedAt   DateTime?
  storeId     String
  store       Store     @relation(fields: [storeId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  metaProductMappings      MetaProductMapping[]
  backInStockSubscriptions BackInStockSubscription[]

  @@unique([storeId, externalId])
  @@index([deletedAt])
}

// ── coupons ─────────────────────────────────────────────────────────────────
enum CouponStatus {
  ACTIVE
  DISABLED
  EXPIRED
}

model Coupon {
  id                String       @id @default(cuid())
  code              String
  discountPct       Int
  status            CouponStatus @default(ACTIVE)
  expiresAt         DateTime?
  deletedAt         DateTime?
  usageCount        Int          @default(0)
  revenueAttributed Decimal?     @db.Decimal(12, 2)
  lastUsedAt        DateTime?
  storeId           String
  store             Store        @relation(fields: [storeId], references: [id])
  customerId        String?
  customer          Customer?    @relation(fields: [customerId], references: [id])
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  usages CouponUsage[]

  @@unique([storeId, code])
  @@index([deletedAt])
}

model CouponUsage {
  id         String    @id @default(cuid())
  couponId   String
  coupon     Coupon    @relation(fields: [couponId], references: [id])
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  usedAt     DateTime  @default(now())
  orderRef   String?

  @@index([couponId])
  @@index([customerId])
}

enum AttributionSource {
  META_POST
  META_DM
  META_STORY
  META_LIVE
  COUPON
  DIRECT
}

model Order {
  id                  String             @id @default(cuid())
  externalId          String
  storeId             String
  store               Store              @relation(fields: [storeId], references: [id])
  total               Decimal?           @db.Decimal(12, 2)
  currency            String?
  orderDate           DateTime
  couponCode          String?
  customerRef         String?
  customerEmail       String?
  attributedMediaId   String?
  attributionSource   AttributionSource?
  isFirstTimeCustomer Boolean            @default(false)
  syncedAt            DateTime           @default(now())
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@unique([storeId, externalId])
  @@index([storeId, attributedMediaId])
  @@index([storeId, couponCode])
  @@index([storeId, orderDate])
  @@index([storeId, isFirstTimeCustomer])
}

// ── crm (customers) ─────────────────────────────────────────────────────────
enum CustomerLifecycleStage {
  LEAD
  PROSPECT
  CUSTOMER
  CHURNED
}

enum CustomerConsent {
  PENDING
  GRANTED
  DECLINED
}

model Customer {
  id               String                 @id @default(cuid())
  storeId          String
  store            Store                  @relation(fields: [storeId], references: [id])
  igUserId         String?
  fbUserId         String?
  username         String?
  interests        String[]
  tags             String[]
  lifecycleStage   CustomerLifecycleStage @default(LEAD)
  consent          CustomerConsent        @default(PENDING)
  consentUpdatedAt DateTime?
  lastActivityAt   DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  conversations            Conversation[]
  coupons                  Coupon[]
  couponUsages             CouponUsage[]
  followers                Follower[]
  socialLeads              SocialLead[]
  ugcAssets                UgcAsset[]
  ambassadors              Ambassador[]
  backInStockSubscriptions BackInStockSubscription[]

  @@index([storeId])
  @@index([igUserId])
  @@index([fbUserId])
}

// ── meta / conversations ────────────────────────────────────────────────────
enum ConversationChannel {
  INSTAGRAM
  FACEBOOK
}

enum ConversationStatus {
  AI_ACTIVE
  HUMAN_ACTIVE
}

model Conversation {
  id              String              @id @default(cuid())
  channel         ConversationChannel
  status          ConversationStatus  @default(AI_ACTIVE)
  externalId      String?
  storeId         String
  store           Store               @relation(fields: [storeId], references: [id])
  customerId      String?
  customer        Customer?           @relation(fields: [customerId], references: [id])
  assignedHumanId String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  messages Message[]

  @@index([storeId])
  @@index([storeId, customerId])
  @@index([customerId])
  @@index([assignedHumanId])
}

enum MessageSender {
  CUSTOMER
  AI
  HUMAN
}

model Message {
  id             String        @id @default(cuid())
  conversationId String
  conversation   Conversation  @relation(fields: [conversationId], references: [id])
  sender         MessageSender
  content        String
  createdAt      DateTime      @default(now())

  @@index([conversationId])
  @@index([createdAt])
}

model Follower {
  id                 String    @id @default(cuid())
  storeId            String
  store              Store     @relation(fields: [storeId], references: [id])
  customerId         String?
  customer           Customer? @relation(fields: [customerId], references: [id])
  igUserId           String?
  username           String?
  followedAt         DateTime  @default(now())
  couponId           String?
  campaignEnrolledAt DateTime?
  welcomeMessageText String?

  @@unique([storeId, igUserId])
}

// ── ai ──────────────────────────────────────────────────────────────────────
model AIConfiguration {
  id              String   @id @default(cuid())
  storeId         String   @unique
  store           Store    @relation(fields: [storeId], references: [id])
  systemPrompt    String
  tone            String?
  welcomeStrategy String?
  couponStrategy  String?
  salesStrategy   String?
  escalationRules String?
  model           String   @default("gpt-4o-mini")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model BrainConversationMemory {
  id                String   @id @default(cuid())
  userId            String
  organizationId    String
  storeId           String?
  question          String
  answer            String
  acceptedAdviceIds String[]
  rejectedAdviceIds String[]
  goals             String[]
  dailyActionId     String?
  outcomeId         String?
  expiresAt         DateTime
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId, storeId])
  @@index([organizationId, createdAt])
  @@index([expiresAt])
}

model RecommendationConflict {
  id             String   @id @default(cuid())
  organizationId String
  storeId        String?
  winnerId       String
  runnerUpId     String?
  winnerTitle    String
  runnerUpTitle  String?
  reason         String
  appliedPolicy  String
  resolvedAt     DateTime @default(now())

  @@index([organizationId, storeId])
  @@index([resolvedAt])
}

// ── campaigns (first-time follower) ─────────────────────────────────────────
enum CampaignType {
  FIRST_TIME_FOLLOWER
}

model Campaign {
  id              String       @id @default(cuid())
  storeId         String
  store           Store        @relation(fields: [storeId], references: [id])
  type            CampaignType @default(FIRST_TIME_FOLLOWER)
  name            String
  discountPct     Int          @default(10)
  couponTtlDays   Int          @default(30)
  messageTemplate String
  active          Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([storeId, type])
}

// ── reports ─────────────────────────────────────────────────────────────────
enum ReportPeriod {
  WEEKLY
  MONTHLY
}

model Report {
  id          String       @id @default(cuid())
  storeId     String
  period      ReportPeriod
  content     Json
  generatedAt DateTime     @default(now())

  @@index([storeId, generatedAt])
}

// ── analytics / competitor intelligence ─────────────────────────────────────
model TrackedAccount {
  id           String    @id @default(cuid())
  storeId      String
  platform     String    @default("INSTAGRAM")
  handle       String
  niche        String?
  note         String?
  lastMedia    Json?
  lastAnalysis Json?
  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([storeId, handle])
}

enum MediaType {
  POST
  REEL
  STORY
  LIVE
  CAROUSEL
}

enum TrendSnapshotType {
  HASHTAG
  AUDIO
  NICHE
}

model MediaPost {
  id              String     @id @default(cuid())
  storeId         String
  store           Store      @relation(fields: [storeId], references: [id])
  trackedAccountId String?
  externalId      String
  platform        String     @default("INSTAGRAM")
  mediaType       MediaType  @default(POST)
  permalink       String?
  caption         String?
  hashtags        String[]
  audioId         String?
  audioName       String?
  thumbnailUrl    String?
  publishedAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  insights MediaInsight[]

  @@unique([storeId, externalId])
  @@index([storeId, publishedAt])
}

model MediaInsight {
  id            String    @id @default(cuid())
  mediaPostId   String
  mediaPost     MediaPost @relation(fields: [mediaPostId], references: [id], onDelete: Cascade)
  impressions   Int?
  reach         Int?
  likes         Int?
  comments      Int?
  shares        Int?
  saves         Int?
  plays         Int?
  views         Int?
  engagementRate Decimal? @db.Decimal(5, 4)
  fetchedAt     DateTime  @default(now())

  @@index([mediaPostId, fetchedAt])
}

model AccountInsight {
  id            String   @id @default(cuid())
  storeId       String
  store         Store    @relation(fields: [storeId], references: [id])
  date          DateTime
  followers     Int?
  profileViews  Int?
  reach         Int?
  impressions   Int?
  websiteClicks Int?
  audienceJson  Json?
  fetchedAt     DateTime @default(now())

  @@index([storeId, date])
}

model TrendSnapshot {
  id        String            @id @default(cuid())
  storeId   String
  store     Store             @relation(fields: [storeId], references: [id])
  type      TrendSnapshotType
  query     String
  data      Json
  fetchedAt DateTime          @default(now())

  @@index([storeId, type, query, fetchedAt])
}

model ContentRecommendation {
  id              String   @id @default(cuid())
  storeId         String
  store           Store    @relation(fields: [storeId], references: [id])
  type            String   @default("REEL")
  title           String
  outline         String
  hashtags        String[]
  audioSuggestion String?
  generatedAt     DateTime @default(now())
  basedOnMediaIds Json

  @@index([storeId, generatedAt])
}

// ── notifications ───────────────────────────────────────────────────────────
enum NotificationType {
  NEW_MESSAGE
  NEW_FOLLOWER
  COUPON_GENERATED
  COUPON_USED
  ESCALATION
  CONVERSATION_TAKEN_OVER
  AI_RESUMED
  SYSTEM_ERROR
  INTELLIGENCE
}

enum NotificationChannel {
  IN_APP
  EMAIL
}

enum NotificationDeliveryTier {
  CRITICAL_INTERRUPT
  ACTION_REQUIRED
  TODAY_FEED
  DIGEST
  ON_DEMAND
}

model Notification {
  id        String                   @id @default(cuid())
  userId    String
  user      User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeId   String?
  type      NotificationType
  channel   NotificationChannel      @default(IN_APP)
  tier      NotificationDeliveryTier @default(TODAY_FEED)
  title     String
  body      String
  payload   Json?
  dedupKey  String?
  read      Boolean                  @default(false)
  createdAt DateTime                 @default(now())

  @@index([userId, read, createdAt])
  @@index([dedupKey, createdAt])
}

// ── commerce (Phase 2) ──────────────────────────────────────────────────────
enum CatalogSyncStatus {
  PENDING
  IN_PROGRESS
  SUCCESS
  FAILED
}

model MetaCatalogSync {
  id                String            @id @default(cuid())
  storeId           String
  store             Store             @relation(fields: [storeId], references: [id])
  externalCatalogId String?
  status            CatalogSyncStatus @default(PENDING)
  lastSyncedAt      DateTime?
  errorLog          String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([storeId, status])
}

model MetaProductMapping {
  id                String    @id @default(cuid())
  storeId           String
  store             Store     @relation(fields: [storeId], references: [id])
  productId         String
  product           Product   @relation(fields: [productId], references: [id])
  externalProductId String?
  externalCatalogId String?
  status            String    @default("PENDING")
  lastPushedAt      DateTime?
  errorMessage      String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([storeId, productId])
  @@index([storeId, status])
}

enum ShoppableMediaStatus {
  DRAFT
  PUBLISHED
  FAILED
}

model ShoppableMedia {
  id              String               @id @default(cuid())
  storeId         String
  store           Store                @relation(fields: [storeId], references: [id])
  externalMediaId String?
  mediaType       String
  caption         String?
  permalink       String?
  productTags     Json?
  status          ShoppableMediaStatus @default(DRAFT)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([storeId, status])
}

enum CommentIntent {
  QUESTION
  COMPLAINT
  COMPLIMENT
  SPAM
  PURCHASE_INTENT
  OTHER
}

enum CommentSentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

model SocialComment {
  id                String           @id @default(cuid())
  storeId           String
  store             Store            @relation(fields: [storeId], references: [id])
  externalMediaId   String?
  externalCommentId String?
  parentId          String?
  externalUserId    String?
  username          String?
  text              String
  intent            CommentIntent    @default(OTHER)
  sentiment         CommentSentiment @default(NEUTRAL)
  autoReplyText     String?
  repliedAt         DateTime?
  hidden            Boolean          @default(false)
  deleted           Boolean          @default(false)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([storeId, externalCommentId])
  @@index([storeId, hidden, createdAt])
}

enum MentionSource {
  MENTION
  TAG
  HASHTAG
}

model SocialMention {
  id              String        @id @default(cuid())
  storeId         String
  store           Store         @relation(fields: [storeId], references: [id])
  externalMediaId String?
  externalUserId  String?
  handle          String?
  mediaUrl        String?
  source          MentionSource
  caption         String?
  hashtags        String[]
  createdAt       DateTime      @default(now())

  @@index([storeId, source])
}

enum LeadSource {
  LEAD_ADS
  DM
  COMMENT
  FOLLOW
}

enum LeadStatus {
  NEW
  SCORED
  NURTURED
  CONVERTED
  DISQUALIFIED
}

model SocialLead {
  id             String     @id @default(cuid())
  storeId        String
  store          Store      @relation(fields: [storeId], references: [id])
  source         LeadSource
  externalFormId String?
  externalLeadId String?
  payload        Json?
  mappedFields   Json?
  status         LeadStatus @default(NEW)
  score          Int        @default(0)
  customerId     String?
  customer       Customer?  @relation(fields: [customerId], references: [id])
  assignedTo     String?
  nurturedAt     DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([storeId, status, score])
}

enum UgcRightsStatus {
  PENDING
  REQUESTED
  APPROVED
  DECLINED
}

model UgcAsset {
  id              String          @id @default(cuid())
  storeId         String
  store           Store           @relation(fields: [storeId], references: [id])
  socialMentionId String?
  customerId      String?
  customer        Customer?       @relation(fields: [customerId], references: [id])
  creatorHandle   String?
  mediaUrl        String?
  mediaType       String?
  source          MentionSource
  caption         String?
  rightsStatus    UgcRightsStatus @default(PENDING)
  approvedBy      String?
  approvedAt      DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([storeId, rightsStatus])
}

enum AmbassadorStatus {
  PENDING
  ACTIVE
  INACTIVE
}

model Ambassador {
  id             String           @id @default(cuid())
  storeId        String
  store          Store            @relation(fields: [storeId], references: [id])
  customerId     String?
  customer       Customer?        @relation(fields: [customerId], references: [id])
  code           String
  discountPct    Int              @default(10)
  commissionPct  Int              @default(5)
  status         AmbassadorStatus @default(PENDING)
  totalReferrals Int              @default(0)
  totalEarnings  Decimal          @default(0) @db.Decimal(12, 2)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  referralOrders ReferralOrder[]

  @@unique([storeId, code])
  @@index([storeId, status])
}

enum ReferralOrderStatus {
  PENDING
  APPROVED
  PAID
}

model ReferralOrder {
  id               String              @id @default(cuid())
  storeId          String
  store            Store               @relation(fields: [storeId], references: [id])
  ambassadorId     String
