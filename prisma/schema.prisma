// ── intelligence (Unified Intelligence Layer) ────────────────────────────────

enum ConfidenceLevel {
  VERIFIED
  PROBABLE
  POSSIBLE
  REJECTED
}

enum LinkStatus {
  ACTIVE
  PENDING
  REVOKED
}

enum DataQualitySeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum DataQualityStatus {
  OPEN
  RESOLVED
  IGNORED
}

enum MetricSnapshotStatus {
  FRESH
  STALE
  MISSING
}

model Signal {
  id               String   @id @default(cuid())
