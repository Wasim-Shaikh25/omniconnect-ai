  recommendationId String?
  decisionType     DecisionType
  reason           String?
  decidedBy        String
  decidedAt        DateTime     @default(now())
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([organizationId, actionPlanId])
}

model Outcome {
  id                    String        @id @default(cuid())
