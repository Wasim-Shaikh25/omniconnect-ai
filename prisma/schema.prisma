// OmniConnect AI — Prisma schema (core tables).
// Each model is owned by a module (see docs/architecture/module-boundaries.md).
// Schema changes go through `prisma migrate` — never hand-edit generated artifacts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── auth / users ────────────────────────────────────────────────────────────
enum Role {
  ADMIN
  STORE_OWNER
  STAFF
}

model User {
  id             String        @id @default(cuid())
  email          String        @unique
  emailVerified  DateTime?
  name           String?
  passwordHash   String?
  image                   String?
  role                  Role            @default(STORE_OWNER)
  organizationId        String?
  organization          Organization?   @relation(fields: [organizationId], references: [id])
  storeId               String?
  store                 Store?          @relation(fields: [storeId], references: [id])
  notificationPreferences Json?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  notifications Notification[]
  accounts      Account[]
  sessions      Session[]
  auditLogs     AuditLog[]
}

// NextAuth (Auth.js) adapter models.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ── organizations ───────────────────────────────────────────────────────────
model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  stores    Store[]
  auditLogs AuditLog[]
}

// ── ecommerce ───────────────────────────────────────────────────────────────
enum EcommerceProvider {
  SHOPIFY
  WOOCOMMERCE
  BIGCOMMERCE
  MAGENTO
  WIX
  CUSTOM
}

model Store {
  id             String            @id @default(cuid())
  name           String
  provider       EcommerceProvider @default(SHOPIFY)
  domain         String?
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id])
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  integrations             Integration[]
  products                 Product[]
  coupons                  Coupon[]
  customers                Customer[]
  conversations            Conversation[]
  followers                Follower[]
  campaigns                Campaign[]
  aiConfig                 AIConfiguration?
  staff                    User[]
  catalogSyncs             MetaCatalogSync[]
  productMappings          MetaProductMapping[]
  shoppableMedia           ShoppableMedia[]
  socialComments           SocialComment[]
  socialMentions           SocialMention[]
  socialLeads              SocialLead[]
  ugcAssets                UgcAsset[]
  ambassadors              Ambassador[]
  referralOrders           ReferralOrder[]
  dmCampaigns              DmCampaign[]
  backInStockSubscriptions BackInStockSubscription[]
  commentUnlockCampaigns   CommentUnlockCampaign[]
  brandDeals               BrandDeal[]
}

enum IntegrationType {
  ECOMMERCE
  META
}

model Integration {
  id           String          @id @default(cuid())
  type         IntegrationType
  provider     String
  externalId   String?
  accessToken  String?
  refreshToken String?
  scopes       String?
  metadata     Json?
  storeId      String
  store        Store           @relation(fields: [storeId], references: [id])
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model Product {
  id          String   @id @default(cuid())
  externalId  String
  title       String
  description String?
  price       Decimal? @db.Decimal(12, 2)
  currency    String?
  inventory   Int?
  imageUrl    String?
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  metaProductMappings      MetaProductMapping[]
  backInStockSubscriptions BackInStockSubscription[]

  @@unique([storeId, externalId])
}

// ── coupons ─────────────────────────────────────────────────────────────────
enum CouponStatus {
  ACTIVE
  DISABLED
  EXPIRED
}

model Coupon {
  id          String       @id @default(cuid())
  code        String
  discountPct Int
  status      CouponStatus @default(ACTIVE)
  expiresAt   DateTime?
  storeId     String
  store       Store        @relation(fields: [storeId], references: [id])
  customerId  String?
  customer    Customer?    @relation(fields: [customerId], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  usages CouponUsage[]

  @@unique([storeId, code])
}

model CouponUsage {
  id         String    @id @default(cuid())
  couponId   String
  coupon     Coupon    @relation(fields: [couponId], references: [id])
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  usedAt     DateTime  @default(now())
  orderRef   String?
}

// ── crm (customers) ─────────────────────────────────────────────────────────
enum CustomerLifecycleStage {
  LEAD
  PROSPECT
  CUSTOMER
  CHURNED
}

enum CustomerConsent {
  PENDING
  GRANTED
  DECLINED
}

model Customer {
  id               String                 @id @default(cuid())
  storeId          String
  store            Store                  @relation(fields: [storeId], references: [id])
  igUserId         String?
  fbUserId         String?
  username         String?
  interests        String[]
  tags             String[]
  lifecycleStage   CustomerLifecycleStage @default(LEAD)
  consent          CustomerConsent        @default(PENDING)
  consentUpdatedAt DateTime?
  lastActivityAt   DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  conversations            Conversation[]
  coupons                  Coupon[]
  couponUsages             CouponUsage[]
  followers                Follower[]
  socialLeads              SocialLead[]
  ugcAssets                UgcAsset[]
  ambassadors              Ambassador[]
  backInStockSubscriptions BackInStockSubscription[]
}

// ── meta / conversations ────────────────────────────────────────────────────
enum ConversationChannel {
  INSTAGRAM
  FACEBOOK
}

enum ConversationStatus {
  AI_ACTIVE
  HUMAN_ACTIVE
}

model Conversation {
  id              String              @id @default(cuid())
  channel         ConversationChannel
  status          ConversationStatus  @default(AI_ACTIVE)
  externalId      String?
  storeId         String
  store           Store               @relation(fields: [storeId], references: [id])
  customerId      String?
  customer        Customer?           @relation(fields: [customerId], references: [id])
  assignedHumanId String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  messages Message[]
}

enum MessageSender {
  CUSTOMER
  AI
  HUMAN
}

model Message {
  id             String        @id @default(cuid())
  conversationId String
  conversation   Conversation  @relation(fields: [conversationId], references: [id])
  sender         MessageSender
  content        String
  createdAt      DateTime      @default(now())
}

model Follower {
  id                 String    @id @default(cuid())
  storeId            String
  store              Store     @relation(fields: [storeId], references: [id])
  customerId         String?
  customer           Customer? @relation(fields: [customerId], references: [id])
  igUserId           String?
  username           String?
  followedAt         DateTime  @default(now())
  couponId           String?
  campaignEnrolledAt DateTime?
  welcomeMessageText String?

  @@unique([storeId, igUserId])
}

// ── ai ──────────────────────────────────────────────────────────────────────
model AIConfiguration {
  id              String   @id @default(cuid())
  storeId         String   @unique
  store           Store    @relation(fields: [storeId], references: [id])
  systemPrompt    String
  tone            String?
  welcomeStrategy String?
  couponStrategy  String?
  salesStrategy   String?
  escalationRules String?
  model           String   @default("gpt-4o-mini")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ── campaigns (first-time follower) ─────────────────────────────────────────
enum CampaignType {
  FIRST_TIME_FOLLOWER
}

model Campaign {
  id              String       @id @default(cuid())
  storeId         String
  store           Store        @relation(fields: [storeId], references: [id])
  type            CampaignType @default(FIRST_TIME_FOLLOWER)
  name            String
  discountPct     Int          @default(10)
  couponTtlDays   Int          @default(30)
  messageTemplate String
  active          Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([storeId, type])
}

// ── reports ─────────────────────────────────────────────────────────────────
enum ReportPeriod {
  WEEKLY
  MONTHLY
}

model Report {
  id          String       @id @default(cuid())
  storeId     String
  period      ReportPeriod
  content     Json
  generatedAt DateTime     @default(now())
}

// ── analytics / competitor intelligence ─────────────────────────────────────
model TrackedAccount {
  id           String    @id @default(cuid())
  storeId      String
  platform     String    @default("INSTAGRAM")
  handle       String
  niche        String?
  note         String?
  lastMedia    Json?
  lastAnalysis Json?
  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([storeId, handle])
}

// ── notifications ───────────────────────────────────────────────────────────
enum NotificationType {
  NEW_MESSAGE
  NEW_FOLLOWER
  COUPON_GENERATED
  COUPON_USED
  ESCALATION
  CONVERSATION_TAKEN_OVER
  AI_RESUMED
  SYSTEM_ERROR
  INTELLIGENCE
}

enum NotificationChannel {
  IN_APP
  EMAIL
}

enum NotificationDeliveryTier {
  CRITICAL_INTERRUPT
  ACTION_REQUIRED
  TODAY_FEED
  DIGEST
  ON_DEMAND
}

model Notification {
  id        String                   @id @default(cuid())
  userId    String
  user      User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeId   String?
  type      NotificationType
  channel   NotificationChannel      @default(IN_APP)
  tier      NotificationDeliveryTier @default(TODAY_FEED)
  title     String
  body      String
  payload   Json?
  dedupKey  String?
  read      Boolean                  @default(false)
  createdAt DateTime                 @default(now())

  @@index([userId, read, createdAt])
  @@index([dedupKey, createdAt])
}

// ── commerce (Phase 2) ──────────────────────────────────────────────────────
enum CatalogSyncStatus {
  PENDING
  IN_PROGRESS
  SUCCESS
  FAILED
}

model MetaCatalogSync {
  id                String            @id @default(cuid())
  storeId           String
  store             Store             @relation(fields: [storeId], references: [id])
  externalCatalogId String?
  status            CatalogSyncStatus @default(PENDING)
  lastSyncedAt      DateTime?
  errorLog          String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([storeId, status])
}

model MetaProductMapping {
  id                String    @id @default(cuid())
  storeId           String
  store             Store     @relation(fields: [storeId], references: [id])
  productId         String
  product           Product   @relation(fields: [productId], references: [id])
  externalProductId String?
  externalCatalogId String?
  status            String    @default("PENDING")
  lastPushedAt      DateTime?
  errorMessage      String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([storeId, productId])
  @@index([storeId, status])
}

enum ShoppableMediaStatus {
  DRAFT
  PUBLISHED
  FAILED
}

model ShoppableMedia {
  id              String               @id @default(cuid())
  storeId         String
  store           Store                @relation(fields: [storeId], references: [id])
  externalMediaId String?
  mediaType       String
  caption         String?
  permalink       String?
  productTags     Json?
  status          ShoppableMediaStatus @default(DRAFT)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([storeId, status])
}

enum CommentIntent {
  QUESTION
  COMPLAINT
  COMPLIMENT
  SPAM
  PURCHASE_INTENT
  OTHER
}

enum CommentSentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

model SocialComment {
  id                String           @id @default(cuid())
  storeId           String
  store             Store            @relation(fields: [storeId], references: [id])
  externalMediaId   String?
  externalCommentId String?
  parentId          String?
  externalUserId    String?
  username          String?
  text              String
  intent            CommentIntent    @default(OTHER)
  sentiment         CommentSentiment @default(NEUTRAL)
  autoReplyText     String?
  repliedAt         DateTime?
  hidden            Boolean          @default(false)
  deleted           Boolean          @default(false)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([storeId, externalCommentId])
  @@index([storeId, hidden, createdAt])
}

enum MentionSource {
  MENTION
  TAG
  HASHTAG
}

model SocialMention {
  id              String        @id @default(cuid())
  storeId         String
  store           Store         @relation(fields: [storeId], references: [id])
  externalMediaId String?
  externalUserId  String?
  handle          String?
  mediaUrl        String?
  source          MentionSource
  caption         String?
  hashtags        String[]
  createdAt       DateTime      @default(now())

  @@index([storeId, source])
}

enum LeadSource {
  LEAD_ADS
  DM
  COMMENT
  FOLLOW
}

enum LeadStatus {
  NEW
  SCORED
  NURTURED
  CONVERTED
  DISQUALIFIED
}

model SocialLead {
  id             String     @id @default(cuid())
  storeId        String
  store          Store      @relation(fields: [storeId], references: [id])
  source         LeadSource
  externalFormId String?
  externalLeadId String?
  payload        Json?
  mappedFields   Json?
  status         LeadStatus @default(NEW)
  score          Int        @default(0)
  customerId     String?
  customer       Customer?  @relation(fields: [customerId], references: [id])
  assignedTo     String?
  nurturedAt     DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([storeId, status, score])
}

enum UgcRightsStatus {
  PENDING
  REQUESTED
  APPROVED
  DECLINED
}

model UgcAsset {
  id              String          @id @default(cuid())
  storeId         String
  store           Store           @relation(fields: [storeId], references: [id])
  socialMentionId String?
  customerId      String?
  customer        Customer?       @relation(fields: [customerId], references: [id])
  creatorHandle   String?
  mediaUrl        String?
  mediaType       String?
  source          MentionSource
  caption         String?
  rightsStatus    UgcRightsStatus @default(PENDING)
  approvedBy      String?
  approvedAt      DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([storeId, rightsStatus])
}

enum AmbassadorStatus {
  PENDING
  ACTIVE
  INACTIVE
}

model Ambassador {
  id             String           @id @default(cuid())
  storeId        String
  store          Store            @relation(fields: [storeId], references: [id])
  customerId     String?
  customer       Customer?        @relation(fields: [customerId], references: [id])
  code           String
  discountPct    Int              @default(10)
  commissionPct  Int              @default(5)
  status         AmbassadorStatus @default(PENDING)
  totalReferrals Int              @default(0)
  totalEarnings  Decimal          @default(0) @db.Decimal(12, 2)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  referralOrders ReferralOrder[]

  @@unique([storeId, code])
  @@index([storeId, status])
}

enum ReferralOrderStatus {
  PENDING
  APPROVED
  PAID
}

model ReferralOrder {
  id               String              @id @default(cuid())
  storeId          String
  store            Store               @relation(fields: [storeId], references: [id])
  ambassadorId     String
  ambassador       Ambassador          @relation(fields: [ambassadorId], references: [id])
  orderId          String
  orderAmount      Decimal             @db.Decimal(12, 2)
  commissionAmount Decimal             @db.Decimal(12, 2)
  status           ReferralOrderStatus @default(PENDING)
  paidAt           DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@unique([storeId, orderId])
  @@index([storeId, status])
}

enum DmCampaignType {
  WELCOME
  ABANDONED_CART
  BACK_IN_STOCK
  REVIEW
  RE_ENGAGE
  ALTERNATIVE_PRODUCT
}

enum DmCampaignStatus {
  DRAFT
  SCHEDULED
  SENT
}

model DmCampaign {
  id               String           @id @default(cuid())
  storeId          String
  store            Store            @relation(fields: [storeId], references: [id])
  campaignType     DmCampaignType
  audienceCriteria Json?
  status           DmCampaignStatus @default(DRAFT)
  scheduledAt      DateTime?
  sentAt           DateTime?
  metrics          Json?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([storeId, campaignType, status])
}

model BackInStockSubscription {
  id             String    @id @default(cuid())
  storeId        String
  store          Store     @relation(fields: [storeId], references: [id])
  productId      String
  product        Product   @relation(fields: [productId], references: [id])
  externalUserId String?
  customerId     String?
  customer       Customer? @relation(fields: [customerId], references: [id])
  createdAt      DateTime  @default(now())
  notifiedAt     DateTime?

  @@unique([storeId, productId, externalUserId])
  @@index([storeId, productId])
}

// ── viral growth (Phase 3) ─────────────────────────────────────────────────
enum CommentUnlockRewardType {
  LINK
  COUPON
  MESSAGE
}

model CommentUnlockCampaign {
  id          String                    @id @default(cuid())
  storeId     String
  store       Store                     @relation(fields: [storeId], references: [id])
  keyword     String
  rewardType  CommentUnlockRewardType   @default(MESSAGE)
  rewardValue String?
  message     String
  referralAsk String?
  active      Boolean                   @default(true)
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
  redemptions CommentUnlockRedemption[]

  @@unique([storeId, keyword])
  @@index([storeId, active])
}

enum CommentUnlockStatus {
  PENDING
  SENT
  REFERRED
}

model CommentUnlockRedemption {
  id             String                @id @default(cuid())
  campaignId     String
  campaign       CommentUnlockCampaign @relation(fields: [campaignId], references: [id])
  storeId        String
  externalUserId String
  username       String?
  commentId      String?
  status         CommentUnlockStatus   @default(PENDING)
  createdAt      DateTime              @default(now())
  sentAt         DateTime?

  @@index([campaignId, status])
  @@index([storeId, externalUserId])
}

enum BrandDealStatus {
  LEAD
  NEGOTIATING
  CONTRACTED
  DELIVERED
  PAID
  CLOSED
}

model BrandDeal {
  id           String          @id @default(cuid())
  storeId      String
  store        Store           @relation(fields: [storeId], references: [id])
  brandName    String
  contactEmail String?
  value        Float?
  status       BrandDealStatus @default(LEAD)
  notes        String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([storeId, status])
  @@index([storeId, createdAt])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  actorId        String?
  actorEmail     String?
  action         String
  resource       String
  resourceId     String?
  details        String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([organizationId, action])
}

// ── intelligence (Unified Intelligence Layer) ────────────────────────────────

enum ConfidenceLevel {
  VERIFIED
  PROBABLE
  POSSIBLE
  REJECTED
}

enum LinkStatus {
  ACTIVE
  PENDING
  REVOKED
}

enum DataQualitySeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum DataQualityStatus {
  OPEN
  RESOLVED
  IGNORED
}

enum MetricSnapshotStatus {
  FRESH
  STALE
  MISSING
}

model Signal {
  id               String   @id @default(cuid())
  organizationId   String
  storeId          String
  eventType        String
  schemaVersion    Int      @default(1)
  subjectType      String
  subjectId        String
  stage            String?
  relatedEntities  Json?
  data             Json?
  lineage          Json?
  source           String
  occurredAt       DateTime
  ingestedAt       DateTime @default(now())
  freshnessMs      Int?
  qualityStatus    String?
  quarantineReason String?
  traceId          String?
  createdAt        DateTime @default(now())

  @@index([organizationId, storeId, subjectType, subjectId])
  @@index([storeId, eventType, ingestedAt])
  @@index([organizationId, ingestedAt])
}

model EntityLink {
  id               String          @id @default(cuid())
  organizationId   String
  storeId          String?
  sourceType       String
  sourceId         String
  targetType       String
  targetId         String
  linkType         String
  confidence       ConfidenceLevel
  resolutionMethod String?
  status           LinkStatus      @default(ACTIVE)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([organizationId, sourceType, sourceId])
  @@index([organizationId, targetType, targetId])
  @@index([storeId, confidence])
}

model DataQualityIssue {
  id             String              @id @default(cuid())
  organizationId String
  storeId        String?
  source         String
  entityType     String?
  entityId       String?
  metricName     String?
  severity       DataQualitySeverity
  impact         String?
  status         DataQualityStatus   @default(OPEN)
  detectedAt     DateTime            @default(now())
  resolvedAt     DateTime?

  @@index([organizationId, status])
  @@index([storeId, severity])
}

model MetricDefinition {
  id             String   @id @default(cuid())
  organizationId String?
  name           String
  displayName    String
  description    String?
  formula        String?
  grain          String?
  dimensions     String[]
  source         String
  freshnessSlaMs Int      @default(3600000)
  owner          String?
  version        Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  snapshots MetricSnapshot[]

  @@unique([organizationId, name])
}

model MetricSnapshot {
  id             String               @id @default(cuid())
  definitionId   String
  definition     MetricDefinition     @relation(fields: [definitionId], references: [id])
  organizationId String
  storeId        String?
  value          Decimal?             @db.Decimal(12, 4)
  dimensions     Json?
  periodStart    DateTime
  periodEnd      DateTime
  status         MetricSnapshotStatus @default(MISSING)
  sourceIds      String[]
  computedAt     DateTime             @default(now())

  @@index([organizationId, storeId, definitionId, computedAt])
  @@index([definitionId, periodStart])
}

enum InsightType {
  ANOMALY
  OPPORTUNITY
  RISK
  INFO
}

enum InsightSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum InsightStatus {
  OPEN
  DISMISSED
  SNOOZED
  RESOLVED
}

model BusinessInsight {
  id             String          @id @default(cuid())
  organizationId String
  storeId        String?
  type           InsightType
  severity       InsightSeverity
  status         InsightStatus   @default(OPEN)
  title          String
  description    String
  evidence       Json?
  deepLink       String?
  generatedAt    DateTime        @default(now())
  dismissedAt    DateTime?
  snoozedUntil   DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([organizationId, status, generatedAt])
  @@index([organizationId, storeId, type, status])
}

// ── intelligence: recommendations, action plans, decisions, outcomes, goals ──

enum RecommendationStatus {
  PROPOSED
  ACCEPTED
  EDITED
  DISMISSED
  SNOOZED
  EXPIRED
}

enum RiskTier {
  TIER_1
  TIER_2
  TIER_3
  TIER_4
}

enum ActionPlanStatus {
  DRAFT
  APPROVED
  EXECUTED
  FAILED
  STOPPED
}

enum DecisionType {
  APPROVED
  EDITED
  ASSIGNED
  SNOOZED
  REJECTED
  EXPIRED
}

enum OutcomeStatus {
  PENDING
  SUCCESS
  PARTIAL
  FAILURE
  ABORTED
}

enum GoalStatus {
  ACTIVE
  PAUSED
  ACHIEVED
  MISSED
  ABANDONED
}

model Recommendation {
  id              String               @id @default(cuid())
  organizationId  String
  storeId         String?
  insightId       String?
  title           String
  description     String
  objective       String?
  reasonCodes     String[]
  impactRange     Json?
  confidence      Float?
  effort          String?
  urgency         String?
  riskTier        RiskTier
  eligibility     Json?
  status          RecommendationStatus @default(PROPOSED)
  actionType      String
  actionParams    Json?
  deepLink        String?
  generatedAt     DateTime             @default(now())
  dismissedAt     DateTime?
  snoozedUntil    DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([organizationId, status, generatedAt])
  @@index([organizationId, storeId, status, riskTier])
}

model ActionPlan {
  id               String            @id @default(cuid())
  organizationId   String
  storeId          String?
  recommendationId String?
  title            String
  steps            Json?
  targetMetric     String?
  expectedImpact   Json?
  status           ActionPlanStatus  @default(DRAFT)
  approvedBy       String?
  executedAt       DateTime?
  stoppedAt        DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([organizationId, storeId, status, createdAt])
}

model Decision {
  id               String       @id @default(cuid())
  organizationId   String
  actionPlanId     String
  recommendationId String?
  decisionType     DecisionType
  reason           String?
  decidedBy        String
  decidedAt        DateTime     @default(now())
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([organizationId, actionPlanId])
}

model Outcome {
  id                    String        @id @default(cuid())
  organizationId        String
  storeId               String?
  actionPlanId          String
  metricName            String?
  beforeValue           Float?
  afterValue            Float?
  observationWindowDays Int           @default(7)
  measuredAt            DateTime?
  status                OutcomeStatus @default(PENDING)
  attribution           String?
  confidence            Float?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([organizationId, storeId, actionPlanId])
}

model Goal {
  id            String     @id @default(cuid())
  organizationId String
  storeId       String?
  name          String
  targetMetric  String
  baseline      Float?
  target        Float?
  startDate     DateTime
  endDate       DateTime?
  ownerUserId   String?
  pacing        Json?
  status        GoalStatus @default(ACTIVE)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([organizationId, status, endDate])
  @@index([organizationId, storeId, targetMetric, status])
}

// ── intelligence: predictions, hypotheses, business learning ────────────────

enum PredictionType {
  CHURN
  STOCK_OUT
  PURCHASE_PROPENSITY
  REVENUE_FORECAST
}

enum PredictionStatus {
  ACTIVE
  EXPIRED
  ABSTAINED
}

enum HypothesisStatus {
  PROPOSED
  VALIDATED
  REFUTED
}

model Prediction {
  id              String           @id @default(cuid())
  organizationId  String
  storeId         String?
  predictionType  PredictionType
  targetEntityType String?
  targetEntityId  String?
  horizon         String
  estimate        Float
  probability     Float?
  lowerBound      Float?
  upperBound      Float?
  features        Json?
  calibration     String?
  expiresAt       DateTime
  status          PredictionStatus @default(ACTIVE)
  reason          String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([organizationId, status, expiresAt])
  @@index([organizationId, storeId, predictionType, status])
}

model Hypothesis {
  id              String           @id @default(cuid())
  organizationId String
  storeId         String?
  insightId       String?
  statement       String
  features        Json?
  expectedOutcome String?
  status          HypothesisStatus @default(PROPOSED)
  validatedAt     DateTime?
  confidence      Float?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([organizationId, status, createdAt])
  @@index([organizationId, storeId, insightId])
}

model BusinessLearning {
  id             String   @id @default(cuid())
  organizationId String
  storeId        String?
  ruleName       String
  condition      Json?
  effect         Json?
  weight         Float    @default(0)
  successCount   Int      @default(0)
  failureCount   Int      @default(0)
  lastOutcomeAt  DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId, ruleName])
  @@index([organizationId, storeId, ruleName])
}

model CompetitorInsight {
  id              String   @id @default(cuid())
  organizationId  String
  storeId         String?
  competitorHandle String
  metricName      String
  value           Float
  benchmarkDelta  Float?
  features        Json?
  source          String?
  capturedAt      DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizationId, storeId, metricName])
  @@index([organizationId, capturedAt])
}

model PortfolioSnapshot {
  id                    String   @id @default(cuid())
  organizationId        String
  storeCount            Int
  totalRevenueEstimate  Float?
  totalChurnRisk        Float?
  topRecommendationType String?
  topRiskStoreId        String?
  features              Json?
  generatedAt           DateTime @default(now())
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([organizationId, generatedAt])
}

model SystemMetric {
  id            String   @id @default(cuid())
  organizationId String
  operation     String
  module        String
  latencyMs     Float?
  costCents     Float?
  status        String   @default("OK")
  traceId       String?
  metadata      Json?
  recordedAt    DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([organizationId, operation, recordedAt])
  @@index([organizationId, module, recordedAt])
}
