  updatedAt        DateTime        @updatedAt

  @@index([organizationId, sourceType, sourceId])
  @@index([organizationId, targetType, targetId])
  @@index([storeId, confidence])
}

model DataQualityIssue {
  id             String              @id @default(cuid())
  organizationId String
  storeId        String?
  source         String
  entityType     String?
  entityId       String?
  metricName     String?
  severity       DataQualitySeverity
  impact         String?
