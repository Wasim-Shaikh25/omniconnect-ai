  detectedAt     DateTime            @default(now())
  resolvedAt     DateTime?

  @@index([organizationId, status])
  @@index([storeId, severity])
}

model MetricDefinition {
  id             String   @id @default(cuid())
  organizationId String?
  name           String
  displayName    String
  description    String?
  formula        String?
  grain          String?
  dimensions     String[]
  source         String
  freshnessSlaMs Int      @default(3600000)
  owner          String?
  version        Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  snapshots MetricSnapshot[]

  @@unique([organizationId, name])
}

model MetricSnapshot {
  id             String               @id @default(cuid())
  definitionId   String
  definition     MetricDefinition     @relation(fields: [definitionId], references: [id])
  organizationId String
  storeId        String?
  value          Decimal?             @db.Decimal(12, 4)
  dimensions     Json?
  periodStart    DateTime
  periodEnd      DateTime
  status         MetricSnapshotStatus @default(MISSING)
  sourceIds      String[]
  computedAt     DateTime             @default(now())

  @@index([organizationId, storeId, definitionId, computedAt])
  @@index([definitionId, periodStart])
}

enum InsightType {
