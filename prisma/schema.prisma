}

// ── intelligence: recommendations, action plans, decisions, outcomes, goals ──

enum RecommendationStatus {
  PROPOSED
  ACCEPTED
  EDITED
  DISMISSED
  SNOOZED
  EXPIRED
}

enum RiskTier {
  TIER_1
